import argparse
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.cm as cm
import matplotlib.colors as mcolors
import scipy.sparse as sp

from gmsh_utils import (
    gmsh_init, gmsh_finalize, open_2d_mesh,
    prepare_quadrature_and_basis, get_jacobians,
)
from stiffness import assemble_stiffness_and_rhs, assemble_robin
from mass import assemble_mass
from dirichlet import theta_step_robin
from plot_utils import plot_fe_solution_2d
from leidenfrost import h_leidenfrost, h_constant

def main():
    parser = argparse.ArgumentParser(description="Trempe 2D lame épée — condition de Robin")
    parser.add_argument("-order",   type=int,   default=1)
    parser.add_argument("--theta",  type=float, default=1.0,    help="1: Euler implicite, 0.5: Crank-Nicolson")
    parser.add_argument("--dt",     type=float, default=0.1,   help="pas de temps [s]")
    parser.add_argument("--nsteps", type=int,   default=30000,   help="nombre de pas de temps")
    parser.add_argument("--leidenfrost", action="store_true",
                    help="Active la loi h(T) Leidenfrost (sinon h constant)")
    args = parser.parse_args()

    # ── Paramètres matériau (acier) ───────────────────────────────────────────
    rho          = 7800.0   # densité [kg/m³]
    cp           = 500.0    # chaleur spécifique [J/kg·K]
    k            = 50.0     # conductivité thermique [W/m·K]
    delta_T_crit = 200.0    # gradient critique avant fissure [°C]

    # ── Paramètres fluide (eau) ───────────────────────────────────────────────
    h_func = h_leidenfrost if args.leidenfrost else h_constant
    T_inf = 20.0     # température de l'eau [°C]

    # ── Température initiale de la lame ───────────────────────────────────────
    T0 = 900.0       # lame sortant du four [°C]

    dt    = args.dt
    nstep = args.nsteps

    # ── Initialisation gmsh ───────────────────────────────────────────────────
