    # ── Mapping tag gmsh → indice dof ────────────────────────────────────────
    unique_tags = np.unique(elemNodeTags)
    num_dofs    = len(unique_tags)
    max_tag     = int(np.max(nodeTags))
    tag_to_dof  = np.full(max_tag + 1, -1, dtype=int)
    for i, tag in enumerate(unique_tags):
        tag_to_dof[int(tag)] = i

    # Coordonnées 2D de chaque dof (pour trouver le nœud central)
    dof_xy     = np.zeros((num_dofs, 2))
    coords_arr = np.asarray(nodeCoords, dtype=float).reshape(-1, 3)
    for i, tag in enumerate(nodeTags):
        d = tag_to_dof[int(tag)]
        if d >= 0:
            dof_xy[d] = coords_arr[i, :2]

    # ── Nœud central et nœuds de surface ─────────────────────────────────────
    # Le nœud central est celui le plus proche de (0,0)
    center_dof = int(np.argmin(np.linalg.norm(dof_xy, axis=1)))

    # Les nœuds de surface sont ceux sur le contour extérieur
    surf_node_tags = bnds_tags[0]
    surf_dofs = np.unique(tag_to_dof[np.asarray(surf_node_tags, dtype=int)])
    surf_dofs = surf_dofs[surf_dofs >= 0]

    print(f"Noeud central : DOF {center_dof}  coords = {dof_xy[center_dof]}")
    print(f"Noeuds de surface : {len(surf_dofs)}")

    # ── Quadrature et base — triangles (volume) ───────────────────────────────
    xi,  w,  N,  gN  = prepare_quadrature_and_basis(elemType, args.order)
    jac, det, coords = get_jacobians(elemType, xi, tag=-1)

    # ── Quadrature et base — segments (frontière) ─────────────────────────────
    # On récupère les éléments du contour extérieur
    import gmsh
    bnd_dimtags = gmsh.model.getBoundary(gmsh.model.getEntities(dim=2),oriented=False)

    from gmsh_utils import getPhysical

    bnd_elemType = gmsh.model.mesh.getElementType("line", args.order)
    xib, wb, Nb, gNb = prepare_quadrature_and_basis(bnd_elemType, args.order)


    all_bnd_elemTags    = []
    all_bnd_elemNodeTags = []
    all_detb            = []
    all_coordsb         = []

    for dim, tag in bnd_dimtags:
        et, ent = gmsh.model.mesh.getElementsByType(bnd_elemType, tag=tag)
        jj, dd, cc = gmsh.model.mesh.getJacobians(bnd_elemType, xib, tag=tag)
        all_bnd_elemTags.append(et)
        all_bnd_elemNodeTags.append(ent)
        all_detb.append(dd)
        all_coordsb.append(cc)

    bnd_elemTags     = np.concatenate(all_bnd_elemTags)
    bnd_elemNodeTags = np.concatenate(all_bnd_elemNodeTags)
    detb             = np.concatenate(all_detb)
    coordsb          = np.concatenate(all_coordsb)
    bnd_entityTag    = bnd_dimtags[0][1]
    

    # ── Assemblage rigidité K et second membre F ──────────────────────────────
    K_lil, F = assemble_stiffness_and_rhs(
        elemTags, elemNodeTags,
        jac, det, coords,
        w, N, gN,
        lambda x: float(k),   # conductivité thermique
        lambda x: 0.0,        # pas de source interne
        tag_to_dof
    )
    K_vol = K_lil.tocsr()
    # ── Assemblage masse M (sans rho·cp) puis multiplication ─────────────────
    # On multiplie après pour garder assemble_mass générique
    M_raw = assemble_mass(elemTags, elemNodeTags, det, w, N, tag_to_dof)
    M     = M_raw.tocsr() * (rho * cp)

    

    # ── Condition initiale : lame uniformément chaude ─────────────────────────
    U = np.full(num_dofs, T0, dtype=float)

    # ── Figure : champ T (gauche) + ΔT centre-surface (droite) ───────────────
    fig, (ax, ax_dt) = plt.subplots(1, 2, figsize=(14, 5))
    plt.ion()

    norm = mcolors.Normalize(vmin=T_inf, vmax=T0)
    sm   = cm.ScalarMappable(cmap='hot', norm=norm)
    sm.set_array([])
    fig.colorbar(sm, ax=ax, label='T [°C]', fraction=0.03, pad=0.04)

    line_dt, = ax_dt.plot([], [], 'b-', linewidth=1.5,
                      label='ΔT (Leidenfrost)' if args.leidenfrost else 'ΔT (h constant)')
    ax_dt.axhline(delta_T_crit, color='r', linestyle='--', linewidth=1.5,
                  label=f'ΔT critique = {delta_T_crit:.0f} °C')
    ax_dt.set_xlim(0, 67)
    ax_dt.set_ylim(0, T0 - T_inf)
    ax_dt.set_xlabel('t [s]')
    ax_dt.set_ylabel('ΔT [°C]')
    ax_dt.set_title('Gradient thermique centre – surface')
    ax_dt.legend(fontsize=9)
    ax_dt.grid(True, alpha=0.3)
    warning_text = ax_dt.text(
        0.98, 0.95, '', transform=ax_dt.transAxes,
        color='red', fontsize=10, fontweight='bold',
        ha='right', va='top'
    )

    plt.show(block=False)
    plt.pause(0.1)

    # ── Boucle en temps ───────────────────────────────────────────────────────
    t_hist, dt_hist = [], []
    exceeded = False

    try:
        for step in range(nstep):
            # Avancement d'un pas de temps — schéma theta avec Robin
            # Pas de condition de Dirichlet : la surface échange via Robin
            T_surf = float(U[surf_dofs].mean())
            h_eff  = h_func(T_surf)

            # Réassemblage Robin uniquement (bord, bon marché)
            K_lil_t = K_vol.tolil().copy()      # repart de K volumique
            F_t     = F.copy()
            K_lil_t, F_t = assemble_robin(
                K_lil_t, F_t,
                bnd_elemTags, bnd_elemNodeTags,
                detb, coordsb,
                wb, Nb,
                h_eff, T_inf,
                tag_to_dof
            )
            K_t = K_lil_t.tocsr()

            U = theta_step_robin(M, K_t, F_t, U, dt=dt, theta=args.theta)

            # ΔT entre le cœur et la surface moyenne
            delta_T = float(U[center_dof] - U[surf_dofs].mean())
            t_cur   = step * dt
            t_hist.append(t_cur)
            dt_hist.append(delta_T)

            # Détection du dépassement du seuil critique
            if delta_T > delta_T_crit and not exceeded:
                print(f"⚠  RISQUE DE FISSURE  t = {t_cur:.2f} s  "
                      f"ΔT = {delta_T:.1f} °C > {delta_T_crit:.0f} °C")
                exceeded = True
            if exceeded and delta_T <= delta_T_crit:
                print(f"   Seuil repassé sous la limite  t = {t_cur:.2f} s  "
                      f"ΔT = {delta_T:.1f} °C")
                exceeded = False

            # Affichage tous les 10 pas
            if step % 10 == 0:
                ax.clear()
                plot_fe_solution_2d(
                    elemNodeTags=elemNodeTags,
                    nodeTags=nodeTags,
                    nodeCoords=nodeCoords,
                    U=U,
                    tag_to_dof=tag_to_dof,
                    vmin=T_inf,
                    vmax=T0,
                    show_mesh=False,
                    ax=ax
                )
                ax.set_title(
                    f"Trempe acier/eau — t = {t_cur:.1f} s    "
                    f"T_moy = {U.mean():.0f} °C",
                    fontsize=11
                )
                ax.set_xlabel("x [m]")
                ax.set_ylabel("y [m]")
                ax.axis('equal')

                line_dt.set_data(t_hist, dt_hist)
                dt_max = max(dt_hist) if dt_hist else 0
                ax_dt.set_ylim(0, max(dt_max * 1.15, delta_T_crit * 1.3))

                if delta_T > delta_T_crit:
                    ax_dt.set_facecolor('#fff0f0')
                    warning_text.set_text('⚠ RISQUE DE FISSURE')
                else:
                    ax_dt.set_facecolor('white')
                    warning_text.set_text('')

                fig.tight_layout()
                plt.pause(0.01)

            # Arrêt anticipé si la lame est refroidie
            if U.mean() <= T_inf + 5.0:
                print(f"   Pièce refroidie (T_moy ≤ T_inf+5)  t = {t_cur:.2f} s")
                break

    finally:
        gmsh_finalize()

    plt.ioff()
    plt.show()


if __name__ == "__main__":
    main()